<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template consumed by scripts/build-release.sh.
  __TEAM_ID__ is substituted with the DEVELOPMENT_TEAM env var at build time.

  method "developer-id"  -> direct distribution / DMG (Gatekeeper, notarized).
  For Mac App Store, change method to "app-store-connect".
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
